# Nexus by MSI — Environment Variables Example
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to git.
# Use separate values for development, staging, and production.

# Supabase
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# App Environment: development | staging | production
VITE_APP_ENV=development

# Sentry Error Monitoring (leave empty for development — without a DSN Sentry is
# never initialised). Set in Vercel env (Production + Preview). VITE_APP_ENV above
# becomes the Sentry `environment`; VITE_SENTRY_RELEASE is optional (e.g. commit SHA).
VITE_SENTRY_DSN=
VITE_SENTRY_RELEASE=
